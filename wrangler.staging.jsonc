{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "code-nest-staged",
	"account_id": "8527ec1369d46f55304a6f59ab5356e4",
	"main": ".open-next/worker.js",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "staged.ateneocode.org",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "code-nest-staged"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "production",
		"DEPLOY_ENV": "prod",
		"STORAGE_MODE": "binding",
		"LOCAL_SQLITE_PATH": "./.local/dev.db",
		"LOCAL_STORAGE_DIR": "./.local/uploads",
		"NEXT_PRIVATE_MINIMAL_MODE": "1",
		// Unfinished surfaces stay hidden on staging until each one ships. Only "true" enables.
		"FEATURE_RETENTION": "false",
		"FEATURE_LIBRARY": "false",
		"FEATURE_ANNOUNCEMENTS": "false",
		"FEATURE_NOTIFICATIONS": "false",
		"FEATURE_SURVEYS": "false",
		"FEATURE_PUBLIC_SITE": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "code-nest-staged-db",
			"database_id": "18b0f067-101b-4aac-b724-6382a7d3cdd0",
			// Staging and production continue production's own migration history, which forked
			// from beta's at 0001. Pointing this at drizzle/migrations would make D1 treat beta's
			// 0001-0019 as unapplied and run them, starting with 17 unguarded DROP TABLEs.
			"migrations_dir": "drizzle/release-migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "code-nest-staged-uploads"
		}
	]
}
