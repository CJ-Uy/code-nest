{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "code-nest-stagged",
	"account_id": "8527ec1369d46f55304a6f59ab5356e4",
	"main": ".open-next/worker.js",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "stagged.ateneocode.org",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "code-nest-stagged"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "production",
		"DEPLOY_ENV": "prod",
		"STORAGE_MODE": "binding",
		"LOCAL_SQLITE_PATH": "./.local/dev.db",
		"LOCAL_STORAGE_DIR": "./.local/uploads",
		"NEXT_PRIVATE_MINIMAL_MODE": "1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "code-nest-staged-db",
			"database_id": "18b0f067-101b-4aac-b724-6382a7d3cdd0",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "code-nest-staged-uploads"
		}
	]
}
